# Copy to .env and adjust. Every value is optional.

# Port Flockit listens on, on this host.
FLOCKIT_PORT=8080

# The address developers' machines use to reach Flockit. It appears in the
# collector install command. Leave empty to use the address the admin used during
# first-run setup (changeable on the Connect page).
# FLOCKIT_PUBLIC_URL=https://flockit.internal.example.com

# Set to true when Flockit is served over HTTPS (behind your reverse proxy).
FLOCKIT_SECURE_COOKIES=false

# Database password. Change it before the first start; the database is never
# exposed outside the compose network, but defaults are defaults.
POSTGRES_PASSWORD=flockit

# An open session with no activity for this many hours is marked abandoned.
FLOCKIT_ABANDON_AFTER_HOURS=6

# Git hosts tasks may point at. Runners send credentials only to these, so a task
# can never make a runner authenticate to someone else's server.
# FLOCKIT_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# Webhook deliveries accepted per workflow per hour.
# FLOCKIT_WEBHOOK_RATE_PER_HOUR=120

# Slack app signing secret. Set it to switch on /flockit commands and @mentions
# (see docs/slack.md). Empty: the Slack endpoints return 404.
# FLOCKIT_SLACK_SIGNING_SECRET=
